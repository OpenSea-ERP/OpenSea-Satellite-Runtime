{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist/main",
    "rootDir": "src/main",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@openholt/satellite-runtime": ["./node_modules/@openholt/satellite-runtime/dist/index.d.ts"],
      "@openholt/satellite-runtime/*": [
        "./node_modules/@openholt/satellite-runtime/dist/*/index.d.ts"
      ]
    }
  },
  "include": ["src/main/**/*"],
  "exclude": ["node_modules"]
}
